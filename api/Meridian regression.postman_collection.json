        {
          "name": "http://localhost:3000/api/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {\n  pm.environment.set(\"token\", pm.response.json().token);\n};\n\n//1\npm.test(\"Status 200\", function () {\n    pm.response.to.have.status(200);\n});\n\n//2\npm.test(\"Tip este Bearer\", function () {\n    pm.expect(pm.response.json().tip).to.eql(\"Bearer\");\n});\n\n//3\npm.test(\"Token expira in 900 s\", function () {\n    pm.expect(pm.response.json().expiraIn).to.eql(900);\n});\n\n//4\npm.test(\"Tokenul e string\", function () {\n    pm.expect(pm.response.json().token).to.be.a('string');\n});\n\n//5\npm.test(\"KNOWN BUG 2: parola apare în răspunsul de login\", function () {\n    pm.expect(pm.response.json().utilizator).to.have.property(\"parola\");\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"client@meridian.ro\", \"parola\": \"Parola123\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
